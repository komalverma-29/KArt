# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kart?schema=public"

# Auth.js (Epic 2)
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public base URL, used to build links in transactional emails
# (e.g. password reset). Do not hardcode this in code.
APP_URL="http://localhost:3000"

# Seed script — used only to create the single Artist account locally.
# Do NOT commit real credentials.
SEED_ARTIST_EMAIL="artist@example.com"
SEED_ARTIST_PASSWORD="change-me-locally"
SEED_ARTIST_FULL_NAME="Artist Name"