# KArt — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Database (tech.md — Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/kart"

# --- Authentication (tech.md — Auth.js, design.md §13.1) ---
AUTH_SECRET=""

# --- File Storage (tech.md — Image Storage, design.md §13.4) ---
# Local filesystem in development; external object storage in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
MAX_UPLOAD_SIZE_MB="10"
